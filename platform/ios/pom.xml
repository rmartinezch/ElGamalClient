<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>pe.gob.onpe.votodigital</groupId>
    <artifactId>votante-ios</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>Votante iOS</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21</javafx.version>
        <gluonfx.plugin.version>1.0.28</gluonfx.plugin.version>
        <main.class>pe.gob.onpe.votodigital.votante.ios.IOSVotanteApp</main.class>
        <cifrador.basedir>${project.basedir}/../..</cifrador.basedir>
    </properties>

    <repositories>
        <repository>
            <id>cifrador-local-repo</id>
            <url>file://${cifrador.basedir}/.mvn/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>verificatum-local</id>
            <url>file://${cifrador.basedir}/native/verificatum-jars</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>gluon-releases</id>
            <url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url>
        </repository>

    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>gluon-releases</id>
            <url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url>
        </pluginRepository>

    </pluginRepositories>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Cifrador -->
        <dependency>
            <groupId>pe.gob.onpe.votodigital</groupId>
            <artifactId>ElGamalCipher</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!-- Verificatum -->
        <dependency>
            <groupId>com.verificatum</groupId>
            <artifactId>verificatum-vcr-vmgj-vecj</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.verificatum</groupId>
            <artifactId>verificatum-vmgj</artifactId>
            <version>1.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.verificatum</groupId>
            <artifactId>verificatum-vecj</artifactId>
            <version>2.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>${gluonfx.plugin.version}</version>
                <configuration>
                    <target>ios-sim</target>
                    <mainClass>${main.class}</mainClass>
                    <graalvmHome>/Users/soettam/Cifrador/.tools/graalvm-svm-java17-darwin-m1-gluon-22.1.0.1-Final/Contents/Home</graalvmHome>
                    <nativeImageArgs>
                        <arg>--no-fallback</arg>
                        <arg>-H:+ReportExceptionStackTraces</arg>
                        <arg>-H:IncludeResources=votante/.*</arg>
                    </nativeImageArgs>
                    <reflectionList>
                        <list>pe.gob.onpe.votodigital.votante.ios.IOSVoterBridge</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.ElGamalCipherService</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.ElGamalPublicKey</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.ElGamalEncoder</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.ElGamalCipher</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.ElGamalCipheredVote</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.Tools</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.CifradorRequest</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.CifradorRngMode</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.PlatformRandomSource</list>
                        <list>pe.gob.onpe.votodigital.elgamalcipher.RandomSourceFactory</list>
                    </reflectionList>
                    <jniList>
                        <list>com.verificatum.vecj.VEC</list>
                        <list>com.verificatum.vmgj.VMG</list>
                    </jniList>
                    <bundlesList>
                    </bundlesList>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
